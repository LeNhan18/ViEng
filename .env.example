# App
APP_ENV=development
LOG_LEVEL=info

# LLM
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=auto
# Claude API (ưu tiên khi có key). Tạo key tại https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Jev (TypeSafe AI, tuỳ chọn): kiểm tra đáp án đề do LLM sinh + quyết định có cần tra RAG
TYPESAFE_API_KEY=
JEV_VERIFY_THRESHOLD=0.8
JEV_RAG_THRESHOLD=0.3
OPENROUTER_API_KEY=
# Model OpenRouter dùng cho mọi tác vụ
LLM_MODEL=openai/gpt-4o-mini
# Số lần cho LLM tự sửa khi output sai schema (sinh đề, dịch)
LLM_MAX_REPAIRS=2
USE_FINETUNED_MODEL=false
HF_MODEL_NAME=
HF_TOKEN=

# CORS: * or comma-separated origins (e.g. http://localhost:5173)
CORS_ORIGINS=*

# Optional: if set, all routes except /, /api/v1/health, /docs require header X-API-Key
API_KEY=

# Auth (JWT) - đổi khi deploy. Khuyến nghị >= 32 bytes (random) cho HS256.
# Sinh nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=10080

# Optional MySQL (set USE_DATABASE=true when ready)
USE_DATABASE=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vieng

# Nếu chạy bằng Docker Compose và MySQL nằm trên máy host:
# DB_HOST_DOCKER=host.docker.internal
# DB_PORT_DOCKER=3306

# RAG
CHROMA_PERSIST_DIR=./data/vectorstore
# Model id Hugging Face hoặc đường dẫn local (vd. E:/AI_CACHE/sentence_transformers/bge-m3)
EMBEDDING_MODEL=BAAI/bge-m3
# Hybrid BM25 + vector (RRF); reranker tuỳ chọn (vd. BAAI/bge-reranker-v2-m3)
RAG_HYBRID=true
RAG_FETCH_K=20
RAG_RERANKER_MODEL=
# Bảo vệ POST /api/v1/rag/index (header X-Admin-Token). Bắt buộc khi APP_ENV=production
ADMIN_TOKEN=

# OCR (chat với ảnh/PDF) - PaddleOCR (PP-StructureV3, fallback 2.x)
OCR_ENABLED=true
OCR_MAX_FILE_SIZE_MB=10
OCR_MAX_PDF_PAGES=10
# Trống = thư mục tạm của hệ điều hành / cache mặc định của Paddle
OCR_TEMP_DIR=
OCR_MODEL_CACHE_DIR=

# Cache TTS/dịch (Redis nếu USE_REDIS=true, nếu không thì RAM)
CACHE_ENABLED=true
TTS_VOICE=en-US-AriaNeural

# Redis/Redict Memory
USE_REDIS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Observability (tuỳ chọn) - Langfuse tracing. Cần: pip install langfuse
# Xem số liệu nhanh không cần Langfuse: GET /api/v1/metrics
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
