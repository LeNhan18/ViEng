# App
APP_ENV=development
LOG_LEVEL=info

# LLM
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=auto
OPENROUTER_API_KEY=
# Model OpenRouter dùng cho mọi tác vụ
LLM_MODEL=openai/gpt-4o-mini
# Số lần cho LLM tự sửa khi output sai schema (sinh đề, dịch)
LLM_MAX_REPAIRS=2
USE_FINETUNED_MODEL=false
HF_MODEL_NAME=
HF_TOKEN=

# CORS: * or comma-separated origins (e.g. http://localhost:5173)
CORS_ORIGINS=*

# Optional: if set, all routes except /, /api/v1/health, /docs require header X-API-Key
API_KEY=

# Auth (JWT) - đổi khi deploy. Khuyến nghị >= 32 bytes (random) cho HS256.
# Sinh nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=10080

# Optional MySQL (set USE_DATABASE=true when ready)
USE_DATABASE=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vieng

# Nếu chạy bằng Docker Compose và MySQL nằm trên máy host:
# DB_HOST_DOCKER=host.docker.internal
# DB_PORT_DOCKER=3306

# RAG
RAG_ENABLED=true
# Thư mục gốc của vectorstore. Bên trong: CURRENT (con trỏ) + versions/<ver>/.
CHROMA_PERSIST_DIR=./data/vectorstore
# ID model trên HuggingFace Hub (không phải đường dẫn thư mục cache).
EMBEDDING_MODEL=BAAI/bge-m3
# Số version index cũ giữ lại sau reindex, để rollback được.
RAG_KEEP_OLD_INDEXES=1

# Cache/temp — để trống thì tự suy ra (./data/cache + thư mục con).
# Đặt giá trị khi muốn cache sang ổ/volume khác. Dùng đường dẫn của HỆ ĐIỀU HÀNH
# đang chạy; không hard-code ổ đĩa vào code.
# CACHE_DIR=./data/cache
# OCR_TEMP_DIR=
# PADDLE_CACHE_DIR=
# HF_CACHE_DIR=

# Khoá cho các endpoint quản trị RAG (/rag/index, /rag/status, /rag/list,
# /rag/rollback), gửi qua header X-Admin-Key.
# Để trống = các endpoint đó bị chặn hoàn toàn (fail-closed).
ADMIN_API_KEY=

# OCR (chat với ảnh/PDF) - RapidOCR
OCR_ENABLED=true
OCR_MAX_FILE_SIZE_MB=10

# Redis/Redict Memory
USE_REDIS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Observability (tuỳ chọn) - Langfuse tracing. Cần: pip install langfuse
# Xem số liệu nhanh không cần Langfuse: GET /api/v1/metrics
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
